{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/admin/dashboard.html"
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/ws/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "admin/dashboard.html"
    }
  ]
}
