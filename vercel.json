{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/kiosk",
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/kiosk/(.*)",
      "destination": "/kiosk/index.html"
    }
  ]
}