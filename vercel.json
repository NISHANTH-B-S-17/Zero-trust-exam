{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/kiosk",
      "dest": "kiosk/index.html"
    },
    {
      "src": "/kiosk/(.*)",
      "dest": "kiosk/$1"
    },
    {
      "src": "/dashboard",
      "dest": "admin/dashboard.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "admin/$1"
    },
    {
      "src": "/",
      "dest": "admin/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "admin/$1"
    }
  ]
}
