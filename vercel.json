{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/admin/dashboard.html"
    }
  ]
}
